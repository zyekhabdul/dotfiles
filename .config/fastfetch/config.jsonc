{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "type": "builtin",
        "position": "top",
        "padding": {
            "top": 0,
            "bottom": 1
        }
    },
    "display": {
        "separator": "   ",
        "color": {
            "keys": "cyan",
            "title": "white"
        },
        "key": {
            "width": 8
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "HOST"
        },
        {
            "type": "kernel",
            "key": "KERNEL"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "TERM"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{1}"
        },
        {
            "type": "memory",
            "key": "MEMORY"
        },
        {
            "type": "disk",
            "key": "DISK",
            "folders": "/"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
